# Google Maps is manual-load only. Opening the site or Map tab must make zero Maps JS initialization calls.
# Restrict the browser key to the production domains in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_MONTHLY_SOFT_LIMIT=9500

# Optional persistent Around My Dorm database. If omitted, the normalized embedded
# dataset remains the database fallback and normal browsing still makes no POI calls.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional maintenance/import credential for server-side admin tooling only.
# Never expose this value to the browser. Normal browsing must not depend on it.
GOOGLE_PLACES_API_KEY=

# Cloud-only persistence (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://gfqkexnqbjtuwsyqacsw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jsDnGIrAjuf0b9w9Hy1z8g_u9SXAfht
# Anonymous Auth must be enabled. App data never falls back to localStorage.
