# Mapbox is the runtime map engine only.
# Restrict the public token to the production domains in Mapbox.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN

# Optional persistent Around My Dorm database. If omitted, the normalized embedded
# dataset remains the database fallback and normal browsing still makes no POI calls.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Maintenance/import only. Never expose a real provider key to the browser and never
# persist provider fields unless the applicable provider policy explicitly allows it.
GOOGLE_PLACES_API_KEY=
