# Browser Google key. Manual-load only; restrict to production HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_MONTHLY_SOFT_LIMIT=9500

# Cloud-only persistence (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://gfqkexnqbjtuwsyqacsw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jsDnGIrAjuf0b9w9Hy1z8g_u9SXAfht
# Anonymous Auth may be used for ordinary browser state, but cost-bearing Google
# maintenance requires a non-anonymous user with app_metadata.amd_admin=true.

# Cloudflare Worker server secret. Configure with:
#   npx wrangler secret put GOOGLE_MAPS_SERVER_API_KEY
# Use a separate Google API key restricted to Routes API. Never prefix it with
# NEXT_PUBLIC_ and never commit its actual value.
GOOGLE_MAPS_SERVER_API_KEY=

# Worker bindings configured in wrangler.jsonc use the public Supabase URL/key to
# validate an incoming user's JWT via /auth/v1/user. No service-role key is needed.
SUPABASE_URL=https://gfqkexnqbjtuwsyqacsw.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_jsDnGIrAjuf0b9w9Hy1z8g_u9SXAfht
